# Required: IANA time zone used to define "a day" and format event times.
TIMEZONE=UTC

# Required: API key clients send in the X-API-KEY header (e.g. openssl rand -hex 32).
X_API_KEY=

# Required: Proton Calendar share link (Settings -> Calendars -> Share -> Share with anyone).
PROTON_CALENDAR_URL=

# Optional: set to true for debug logging (default: false).
# DEBUG=false
