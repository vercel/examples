# Required: HTTPS base URL of the folder that holds your .pmtiles archives, such as
# a public Vercel Blob store (https://<store-id>.public.blob.vercel-storage.com/tiles).
PMTILES_BUCKET=

# Optional: allowed CORS origins, comma-separated. The image defaults to *.
# PMTILES_CORS=https://example.com

# Optional: public URL of this deployment, used in TileJSON tile URLs.
# PMTILES_PUBLIC_URL=https://<your-deployment>.vercel.app
