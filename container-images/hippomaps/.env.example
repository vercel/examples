# Key of the map tiles API (api.overpass.ch by default). The page sends it to the browser.
MAPS_KEY=

# Optional: an overpass-search server for the plain-words search, relayed under /api/search.
SEARCH_UPSTREAM=

# Optional: a Valhalla server for directions.
ROUTING_URL=

# Optional: the public address of the site, for canonical links, robots.txt and sitemap.xml.
PUBLIC_URL=
