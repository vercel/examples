# Required: Postgres 17. The server's role must not be a superuser or have BYPASSRLS.
DATABASE_URL=
# Recommended: the database owner's URL, used only to migrate at startup.
WAKESHIFT_MIGRATE_DATABASE_URL=

# Required: this deployment's https URL, no path (for example https://wakeshift-example.vercel.app).
WAKESHIFT_PUBLIC_URL=
# Required: at least 32 random bytes, for example `openssl rand -base64 48`.
WAKESHIFT_SECRET_KEY=
# Apps registered at startup, as printed by /appkey (or create apps in the console).
WAKESHIFT_APPS=[]

# MCP Events push (events/stream). Off by default on non-localhost hosts.
WAKESHIFT_MCP_EVENTS_PUSH=1

# Optional: console sign-in (set both halves of a pair).
WAKESHIFT_GITHUB_CLIENT_ID=
WAKESHIFT_GITHUB_CLIENT_SECRET=
WAKESHIFT_ALLOWED_SIGNUPS=
