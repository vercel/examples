# Required: PostgreSQL with the PostGIS extension available (for example from a Marketplace Postgres integration).
DATABASE_URL=

# Optional: keys for your own apps, name=key comma-separated. Each key is otr_master_ plus 32+ random characters:
#   echo otr_master_$(openssl rand -hex 24)
OPENTAXRATE_MASTER_KEYS=

# Optional: per-IP limit for unkeyed lookups, e.g. 60/min (kept in memory, per instance).
OPENTAXRATE_PUBLIC_LIMIT=

# Optional: browser origins allowed to call the API, comma-separated.
OPENTAXRATE_CORS_ORIGINS=

# Optional: identifies you to the states' and geocoders' sites; include a contact.
OPENTAXRATE_USER_AGENT=

# Optional: turn off the free public geocoders (see Caveats).
NOMINATIM_DISABLED=
CENSUS_DISABLED=
