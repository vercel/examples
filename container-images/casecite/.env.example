# Secrets: generate a fresh value for each one
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 16
ENCRYPTION_SALT=
# openssl rand -hex 32
AUDIT_HMAC_KEY=
# openssl rand -hex 16, needed to create the first (admin) account
REGISTRATION_BOOTSTRAP_TOKEN=

# Postgres (for example Neon from the Vercel Marketplace). Use the postgresql+asyncpg:// scheme
# and drop query parameters such as ?sslmode=require; TLS is controlled by DB_SSL.
DATABASE_URL=
DB_SSL=require

# Redis (for example Upstash or Redis Cloud from the Vercel Marketplace). Use rediss:// for TLS.
REDIS_URL=

# Your deployment's public hostname and origin
# casecite-example.vercel.app
ALLOWED_HOSTS=
# https://casecite-example.vercel.app
CORS_ORIGINS=

# Confirms you accept that derived text (chunks, chat history) is stored in cleartext
# in your database, Redis and vector store, and that they are encrypted at rest.
DISK_ENCRYPTION_ACKNOWLEDGED=true

# AI providers: set at least one server key, or leave empty and let each user save their own key.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint for chat and embeddings, for example Vercel AI Gateway:
# OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# EMBEDDING_BASE_URL=https://ai-gateway.vercel.sh/v1

# Vector store: the default (chroma) lives on the instance's local disk. Use Pinecone for a
# shared, durable index on Vercel.
# VECTOR_DB=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=casecite-legal

# Optional: CourtListener token for case-law tools
# COURTLISTENER_API_TOKEN=
