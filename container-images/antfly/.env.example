# Required: password for the built-in `admin` user (12 to 72 bytes).
# Each instance creates `admin` with this password on its first start.
ANTFLY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: AI Gateway key for generation and embeddings through https://ai-gateway.vercel.sh/v1.
# Antfly resolves the secret reference ${secret:ai_gateway.api_key} from this variable.
AI_GATEWAY_API_KEY=
