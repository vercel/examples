# Postgres. Installing Neon from the Vercel Marketplace sets DATABASE_URL and
# DATABASE_URL_UNPOOLED; the container prefers the unpooled one.
DATABASE_URL=

# At least 32 random characters, the same on every instance: openssl rand -hex 32
HATAMOTO_SECRET=

# Code the first-run wizard asks for (at least 12 characters, not a repeated pattern).
HATAMOTO_SETUP_CODE=

# Optional: your public origin. Enables the HTML page cache, canonical links and sitemaps.
# PUBLIC_BASE_URL=https://your-project.vercel.app

# Optional: pin the admin address, for example /studio. Otherwise a private one is generated.
# HATAMOTO_ADMIN_PATH=/studio
