# Required: Postgres connection string. Installing Neon (or another Postgres) from the Vercel Marketplace sets it.
DATABASE_URL=
# Optional: a direct (unpooled) connection for migrations and backups, when DATABASE_URL goes through a pooler.
DATABASE_DIRECT_URL=

# Required: at least 32 random characters, the same for every instance. Generate with `openssl rand -hex 32`.
HATAMOTO_SECRET=
# Required for first run: the code the setup wizard asks for (12+ characters, not a repeated pattern).
HATAMOTO_SETUP_CODE=
# Recommended: pin the private admin address, one segment of 4-64 lowercase letters, digits or dashes.
HATAMOTO_ADMIN_PATH=/my-admin
# Recommended: your public origin, used in canonical links, sitemaps and emails.
PUBLIC_BASE_URL=https://your-project.vercel.app
# Recommended: let idle instances release their database connections.
DATABASE_MIN_CONNECTIONS=0
# Recommended: Vercel Functions accept request bodies up to 4.5 MB, so keep uploads below that.
MEDIA_MAX_SIZE_MB=4

# Media uploads: Vercel's file system is not persistent, so use S3-compatible object storage.
MEDIA_STORAGE=s3
HATAMOTO_MEDIA_S3_ENDPOINT=
HATAMOTO_MEDIA_S3_REGION=
HATAMOTO_MEDIA_S3_BUCKET=
HATAMOTO_MEDIA_S3_PREFIX=
HATAMOTO_MEDIA_S3_ACCESS_KEY=
HATAMOTO_MEDIA_S3_SECRET_KEY=
