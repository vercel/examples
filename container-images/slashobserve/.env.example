# Required: Postgres. With Neon from the Vercel Marketplace, use the pooled URL here...
SLASHOBSERVE_DATABASE_URL=
# ...and the direct (unpooled) URL here, for live updates (LISTEN) and migrations.
SLASHOBSERVE_DATABASE_DIRECT_URL=

# Required: the address people use, e.g. https://<your-project>.vercel.app
SLASHOBSERVE_PUBLIC_URL=

# Required for browser sign-in: an OIDC client whose redirect URI is <public url>/api/v1/auth/callback
SLASHOBSERVE_OIDC_ISSUER_URL=
SLASHOBSERVE_OIDC_CLIENT_ID=
SLASHOBSERVE_OIDC_CLIENT_SECRET=
SLASHOBSERVE_AUTH_ALLOWED_EMAIL_DOMAINS=

# Recommended
SLASHOBSERVE_ADMIN_EMAILS=
# openssl rand -hex 32
SLASHOBSERVE_SECRET_KEY=

# Optional: turn on the built-in agent (anthropic or openai)
SLASHOBSERVE_LLM_PROVIDER=
SLASHOBSERVE_LLM_API_KEY=
