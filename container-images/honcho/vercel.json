{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "daemons": {
    "deriver": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "command": ["/app/.venv/bin/python", "-m", "src.deriver"],
      "instances": { "iad1": 1 }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
