# Required: Postgres with pgvector. Use the postgresql+psycopg:// prefix.
DB_CONNECTION_URI=

# Required: signs and verifies API keys (JWTs). Generate with: openssl rand -hex 32
# The image sets AUTH_USE_AUTH=true, so Honcho refuses to start without it.
AUTH_JWT_SECRET=

# Required: OpenAI key. Used for text generation and for embeddings by default.
LLM_OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoints for text generation and embeddings.
# LLM_OPENAI_BASE_URL=
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=
