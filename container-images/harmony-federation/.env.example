# Supabase project (Vercel Marketplace integration sets SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY, which the image also accepts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public domain of this instance, without https://
INSTANCE_DOMAIN=harmony.example.com
# Optional: browser origin of the Harmony web app
CORS_ORIGIN=https://harmony.example.com
# Optional: Redis for cache, rate limits and queues (runs without it)
REDIS_URL=
