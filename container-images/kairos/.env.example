# Postgres connection string. Use the pooled URL of a Marketplace Postgres such as Neon.
DATABASE_URL=
# Key for Finic's Grayson decision model, from https://portal.finic.ai/keys
GRAYSON_API_KEY=
# Optional: "invite" so that new accounts need an invite link. Set it after you create the first account.
KAIROS_SIGNUP=
# Needed for webhooks. 32 bytes: openssl rand -base64 32. Never change it once set.
KAIROS_ENCRYPTION_KEY=
# Optional: opens GET /internal/jobs/drain to a scheduler that retries webhook deliveries.
CRON_SECRET=
