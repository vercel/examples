# Required: PostgreSQL connection string. Paste the URL from your Marketplace Postgres (for example Neon).
ZEROAUTHY_STORAGE__DSN=

# Required: 32-byte master key that encrypts signing keys and client secrets. Generate with: openssl rand -base64 32
ZEROAUTHY_SECURITY__MASTER_KEY=

# Required: host name of the admin console, for example my-zeroauthy-admin.vercel.app
ZEROAUTHY_SERVER__SYSTEM_HOST=
