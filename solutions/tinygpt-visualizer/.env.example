# All optional. These are build-time values and end up in the public bundle, so never put secrets here.

# Upstream commit of oshea00/tinygpt-viz to build.
TINYGPT_COMMIT=
# Hugging Face revision of the model export (oshea00/tinygpt-viz, web/bpe-small).
MODEL_REVISION=
# Full model base URL (must end in /). Overrides MODEL_REVISION, e.g. to host the model yourself.
VITE_MODEL_URL=
