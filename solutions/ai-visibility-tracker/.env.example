# ──────────────────────────────────────────────────────────────────────────────
# AI Visibility Tracker — environment
# Copy to .env.local for local development. On Vercel, set these in the project
# settings (the Deploy button asks for them).
# ──────────────────────────────────────────────────────────────────────────────

# Password for the single admin account. Required.
ADMIN_PASSWORD=change-me

# Shared secret for Vercel Cron and for the background run processor.
# Required on Vercel: generate one with `openssl rand -hex 32`.
CRON_SECRET=

# Postgres connection string (Neon, Supabase, RDS, local…).
# Leave empty locally to use an embedded PGlite database in ./data/pglite.
DATABASE_URL=

# ── AI access ─────────────────────────────────────────────────────────────────
# One key for every platform: create it at https://vercel.com/ai-gateway
# On Vercel deployments this can stay empty — the gateway authenticates with
# the deployment's OIDC token automatically.
# Either way the team's AI Gateway balance must be positive (Vercel dashboard →
# AI Gateway → Credits); with no credits every platform request fails.
AI_GATEWAY_API_KEY=

# Alternative: call the vendors directly with your own keys (used only when
# AI_GATEWAY_API_KEY is empty and the app is not running on Vercel).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=

# ── Optional tuning ───────────────────────────────────────────────────────────
# Override the model behind each platform (gateway ids: creator/model).
# MODEL_CHATGPT=openai/gpt-5.4-nano
# MODEL_PERPLEXITY=perplexity/sonar
# MODEL_GEMINI=google/gemini-3-flash
# MODEL_CLAUDE=anthropic/claude-haiku-4.5
# MODEL_GROK=xai/grok-4.20-non-reasoning
# MODEL_EXTRACTOR=openai/gpt-4o-mini

# Public URL of the app, used when the run processor re-invokes itself.
# Defaults to the incoming request origin (or VERCEL_PROJECT_PRODUCTION_URL).
# APP_URL=https://tracker.example.com

# Wall-clock budget of one processing invocation, in ms. Hobby functions stop
# at 300 s, so the default leaves room for in-flight platform calls.
# RUN_BATCH_BUDGET_MS=140000

# ── Public demo only ──────────────────────────────────────────────────────────
# DEMO_MODE=1 opens every page without a password, refuses all changes from
# visitors, disables the scheduled check, and seeds sample data at build time.
# Never set it on a real tracker.
# DEMO_MODE=
